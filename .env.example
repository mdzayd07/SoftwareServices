# ==============================================================================
# Northline Software - Production Deployment Environment Variables
# Copy this file to `.env` on your server and update with strong credentials
# ==============================================================================

# Server & Port Settings
APP_PORT=8090
BACKEND_PORT=8085
FRONTEND_PORT=4010
DOMAIN_NAME=yourdomain.com

# Database Settings
POSTGRES_DB=services_site
POSTGRES_USER=services_site
POSTGRES_PASSWORD=ReplaceWithStrongDbPassword123!

# Admin Authentication
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=ReplaceWithStrongAdminPassword2026!

# Lead Ingestion & Notifications
LEAD_NOTIFY_TO=contact@yourdomain.com
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Production Domain
DOMAIN_NAME=yourdomain.com

# SMTP Settings (Optional, e.g. Amazon SES, SendGrid, Gmail SMTP)
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=apikey
MAIL_PASSWORD=your_smtp_api_key_here
MAIL_FROM=no-reply@yourdomain.com
